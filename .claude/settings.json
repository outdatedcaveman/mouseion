    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/mind_bind.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/mind_bind.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/mind_bind.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/mind_bind.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
